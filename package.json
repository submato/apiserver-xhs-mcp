{
  "name": "apiserver-xhs-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server for paid Xiaohongshu data APIs, including note search, details, comments, users, and user posts.",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "xiaohongshu",
    "xhs",
    "rednote",
    "rednote-api",
    "social-media-api",
    "ai-agent",
    "cursor",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/submato/apiserver-xhs-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/submato/apiserver-xhs-mcp/issues"
  },
  "homepage": "https://github.com/submato/apiserver-xhs-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
